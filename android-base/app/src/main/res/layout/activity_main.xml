<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/toolbar" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_above="@+id/toolbar"
        android:max="100"
        android:progressTint="#1f6feb" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@color/toolbar_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button android:id="@+id/btn_back" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="◀" android:textColor="#ffffff" android:textSize="18sp" />
        <Button android:id="@+id/btn_forward" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="▶" android:textColor="#ffffff" android:textSize="18sp" />
        <Button android:id="@+id/btn_refresh" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="⟳" android:textColor="#ffffff" android:textSize="18sp" />
        <Button android:id="@+id/btn_home" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="⌂" android:textColor="#ffffff" android:textSize="18sp" />
        <Button android:id="@+id/btn_download" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="⤓" android:textColor="#ffffff" android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#80000000"
        android:padding="12dp"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:visibility="gone" />
</RelativeLayout>
